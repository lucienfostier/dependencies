+      /// A parametric parameter - represents 'functions' that the plug-in can
+      /// ask the host to evaluate at arbitrary positions (e.g. lookup tables).
+      /// The plug-in may also edit the curves through the parametric suite.
+      class ParametricInstance : public Instance {
+      public:
+        ParametricInstance(Descriptor& descriptor, Param::SetInstance* instance = 0);
+
+        int getDimension() const { return (int)m_curves.size(); }
+        const std::vector<std::vector<std::pair<double,double> > > &curves() const { return m_curves; }
+
+        /// Dispatch points for the parametric suite - derived hosts may
+        /// override these to back the curves with their own storage.
+        virtual OfxStatus getValue(int curveIndex, double time, double parametricPosition, double *returnValue);
+        virtual OfxStatus getNControlPoints(int curveIndex, double time, int *count);
+        virtual OfxStatus getNthControlPoint(int curveIndex, double time, int nthCtl, double *key, double *value);
+        virtual OfxStatus setNthControlPoint(int curveIndex, double time, int nthCtl, double key, double value, bool addAnimationKey);
+        virtual OfxStatus addControlPoint(int curveIndex, double time, double key, double value, bool addAnimationKey);
+        virtual OfxStatus deleteControlPoint(int curveIndex, int nthCtl);
+        virtual OfxStatus deleteAllControlPoints(int curveIndex);
+
+      private:
+        /// one curve per dimension, control points sorted by key
+        std::vector<std::vector<std::pair<double,double> > > m_curves;
+      };
+#endif
