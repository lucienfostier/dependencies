+/** @file ofxhParametricParam.h
+ *
+ * Host-side support for the optional OFX parametric parameter suite.
+ * This file is referenced (but not shipped) by the OpenFX SDK sources,
+ * and provides the suite entry point used by the host's fetchSuite.
+ */
+
+#pragma once
+
+#include "ofxCore.h"
+
+namespace OFX {
+
+  namespace Host {
+
+    /// Suite fetcher for the parametric parameter suite.
+    /// Returns a pointer to the suite struct for the requested version,
+    /// or NULL if the version is not supported.
+    namespace ParametricParam {
+      const void *GetSuite(int suiteVersion);
+    }
+
+  } // Host
+
+} // OFX
