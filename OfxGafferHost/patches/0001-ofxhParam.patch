@@ -1663,6 +1666,38 @@
       ////////////////////////////////////////////////////////////////////////////////
       // Suite functions below
 
+      // Registry mapping handles (both Instance* and Descriptor*) to Instance*.
+      // Sapphire caches Descriptor* handles from DescribeInContext and passes them
+      // to paramGetValue during render. By registering both handles, we can map
+      // Sapphire's descriptor handles back to the correct Instance for getV().
+      // Protected by a mutex because Gaffer's compute can run on multiple threads.
+      static std::unordered_map<const void*, Instance*> g_handleToInstance;
+      static std::mutex g_instanceRegistryMutex;
+
+      void registerInstance(Instance* inst, const void* descriptorHandle) {
+        std::lock_guard<std::mutex> lock(g_instanceRegistryMutex);
+        g_handleToInstance[inst] = inst;           // Instance* → self
+        g_handleToInstance[descriptorHandle] = inst; // Descriptor* → Instance
+      }
+
+      void unregisterInstance(Instance* inst) {
+        std::lock_guard<std::mutex> lock(g_instanceRegistryMutex);
+        for(auto it = g_handleToInstance.begin(); it != g_handleToInstance.end(); ) {
+          if(it->second == inst) it = g_handleToInstance.erase(it);
+          else ++it;
+        }
+      }
+
+      /// Safe conversion from opaque param handle to Param::Instance*.
+      /// Uses a registry lookup (no memory reads from the handle itself)
+      /// to avoid SIGSEGV from __dynamic_cast on corrupted/dangling pointers.
+      static inline Instance* instanceFromHandle(OfxParamHandle handle) {
+        if(!handle) return nullptr;
+        std::lock_guard<std::mutex> lock(g_instanceRegistryMutex);
+        auto it = g_handleToInstance.find(handle);
+        return it != g_handleToInstance.end() ? it->second : nullptr;
+      }
