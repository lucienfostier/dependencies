# OfxGafferHost : Pre-run `DescribeInContext` and guard null handles
#
# Some plugins, for example ColorLookup and Shadertoy, query contexts
# during `Describe` that stock HostSupport did not pre-describe. Other
# hosts also call `createInstance` with a null handle and crash.
#
# Pre-run `DescribeInContext` for every known context after `Describe`,
# so overlay interact and clip preferences are ready before instance
# creation. Return `kOfxStatErrBadHandle` from `createInstance` when the
# handle is null.
--- a/HostSupport/src/ofxhImageEffectAPI.cpp
+++ b/HostSupport/src/ofxhImageEffectAPI.cpp
@@ -184,6 +184,18 @@
             _pluginHandle.reset();
             return nullptr;
           }
+
+          try {
+            // Also do DescribeInContext for each known context so it's ready
+            for( const auto &ctx : _knownContexts ) {
+              Descriptor *desc = getContext(ctx);
+              if( !desc ) {
+                std::cerr << "WARN: DescribeInContext failed for context " << ctx << std::endl;
+              }
+            }
+          } catch( ... ) {
+            std::cerr << "WARN: DescribeInContext threw exception" << std::endl;
+          }
         }
 
         return _pluginHandle.get();
@@ -239,7 +251,10 @@
         /// (not because we are expecting the results to change, but because plugin
         /// might get confused otherwise), then a describe_in_context
 
-        getPluginHandle();
+        if( !getPluginHandle() )
+        {
+          return 0;
+        }
 
         Descriptor *desc = getContext(context);
         
